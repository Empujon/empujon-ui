# Publicar el scope @empujon a GitHub Packages.
# Para publicar/instalar, exportá un token de GitHub con scope read:packages (y write:packages para publicar):
#   export NODE_AUTH_TOKEN=ghp_xxx   (CI)
#   o configurá ~/.npmrc con: //npm.pkg.github.com/:_authToken=ghp_xxx
@empujon:registry=https://npm.pkg.github.com
