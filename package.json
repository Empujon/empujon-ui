{
  "name": "@empujon/ui",
  "version": "0.1.4",
  "description": "Sistema de diseño de Empujón — componentes React + tokens compartidos (web y Flutter).",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "tokens/tokens.json",
    "tokens/generated",
    "tailwind-preset.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./tokens": "./tokens/generated/tokens.ts",
    "./tokens.json": "./tokens/tokens.json"
  },
  "scripts": {
    "tokens": "node tokens/build-tokens.mjs",
    "build": "npm run tokens && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.18",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "react": "^18",
    "react-dom": "^18",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vite": "^6.4.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Empujon/empujon-ui.git"
  }
}
